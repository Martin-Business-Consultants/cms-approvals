<%# locals: (value:, other:, side:) %>
<%# One side of a changed part: text with the other side's differences
    marked (approvals_word_diff), anything else as JSON, — for nothing. %>
<% if value.nil? || value == "" then %>
  <span class="text-faint">—</span>
<% elsif value.is_a?(String) && (other.is_a?(String) || other.nil?) then %>
  <% live_text = side == :live ? value : other.to_s %>
  <% proposed_text = side == :live ? other.to_s : value %>
  <pre class="approvals__value"><%= approvals_word_diff(live_text, proposed_text, side: side) %></pre>
<% else %>
  <pre class="approvals__value"><%= value.is_a?(String) ? value : JSON.pretty_generate(value) %></pre>
<% end %>
