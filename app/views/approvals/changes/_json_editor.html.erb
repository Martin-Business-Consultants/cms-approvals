<%# locals: (label:, name:, typed:, open: false) %>
<%# The whole of a JSON value as proposed, to change by hand if it needs it,
    folded away under the parts that changed. %>
<div class="approvals__label text-muted"><%= label %>, whole</div>
<div class="approvals__cell approvals__cell--live text-small text-muted">Only needed to change the proposal by hand.</div>
<div class="approvals__cell">
  <%= tag.details open: open do %>
    <summary class="text-medium text-body">Edit as JSON</summary>
    <%= text_area_tag name, typed, rows: (typed.to_s.lines.size + 1).clamp(6, 30), class: "approvals__json", aria: { label: label } %>
  <% end %>
</div>
