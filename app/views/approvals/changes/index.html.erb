<% @page_title = "Approvals" %>

<%= render "layouts/shared/page_header", title: @page_title,
      description: "Changes an agent made through the API, the cms CLI or MCP wait here. Open one to compare it with what’s live, edit it, and approve it." %>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
  <% bulk = @state == "pending" && @changes.any? && Current.user.can?("approvals:decide") %>
  <% list_controller = bulk ? "select-all" : "" %>
  <section class="<%= ui(:panel, "min-w-0") %>" aria-label="Proposed changes" data-controller="<%= list_controller %>">
    <nav class="flex gap-1 border-b border-gray-200 px-4" aria-label="Show">
      <% [["pending", "Waiting"], ["decided", "Decided"]].each do |state, label| %>
        <%# herb:key state %>
        <%= link_to approvals_changes_path(state: (state unless state == "pending")),
              class: class_names("approvals__tab", "approvals__tab--current": @state == state), aria: { current: (@state == state ? "page" : nil) } do %>
          <%= label %> <span class="text-gray-500"><%= @counts[state] %></span>
        <% end %>
      <% end %>
    </nav>
    <% if bulk then %>
      <%# Approve or reject the ticked ones, as proposed. %>
      <%= form_with url: approvals_bulk_decisions_path, id: "approvals_bulk", class: "flex flex-wrap items-center gap-2 border-b border-gray-200 px-4 py-2.5" do %>
        <label class="flex items-center gap-2 text-sm text-gray-700">
          <input type="checkbox" data-select-all-target="all" data-action="select-all#toggle" aria-label="Tick every change">
          <span>All</span>
        </label>
        <span class="ml-auto flex gap-2">
          <button type="submit" name="decision" value="reject" class="<%= ui(:button, :small, "text-red-700") %>"
                  data-turbo-confirm="Reject the ticked changes? Nothing in them goes live.">Reject ticked</button>
          <button type="submit" name="decision" value="approve" class="<%= ui(:button, :primary, :small) %>"
                  data-turbo-confirm="Approve the ticked changes as proposed? They go live.">Approve ticked</button>
        </span>
      <% end %>
    <% end %>
    <% if @changes.any? then %>
      <ul class="divide-y divide-gray-100">
        <% @changes.each do |change| %>
          <%# herb:key change.id %>
          <li id="<%= dom_id(change) %>" class="flex items-start">
            <% if bulk then %>
              <label class="flex pl-4 pt-3" aria-label="Tick <%= change.summary %>">
                <input type="checkbox" name="ids[]" value="<%= change.id %>" form="approvals_bulk" data-select-all-target="box" data-action="select-all#sync">
              </label>
            <% end %>
            <%= link_to approvals_change_path(change), class: "flex min-w-0 flex-1 items-start justify-between gap-3 px-4 py-3 hover:bg-gray-50" do %>
              <span class="flex min-w-0 flex-col gap-0.5">
                <span class="truncate text-sm font-medium text-gray-900"><%= change.summary %></span>
                <span class="text-xs text-gray-500">
                  <%= change.proposed_by %> · <%= time_ago_tag change.created_at %>
                  <% if change.pending? then %> · <%= pluralize(change.changed_fields.size, "field") %><% end %>
                </span>
                <% if change.pending? && change.stale? then %>
                  <span class="text-xs text-red-700">The live <%= change.kind %> changed since this was proposed</span>
                <% end %>
              </span>
              <%= status_tag change.state.capitalize %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="px-4 py-12 text-center text-sm text-gray-500">
        <%= @state == "pending" ? "Nothing waiting. When an agent changes a page, an entry or a global through the API, the change lands here instead of going live." : "Nothing decided yet." %>
      </p>
    <% end %>
  </section>

  <section class="<%= ui(:panel, "flex flex-col items-center justify-center gap-2 px-6 py-12 text-center") %>" aria-label="Comparison">
    <%= icon_tag "check-circle", class: "size-8 text-gray-400" %>
    <p class="text-sm font-medium text-gray-900">Open a change to compare it</p>
    <p class="max-w-sm text-sm text-gray-500">
      What’s live now shows here on the left, what’s proposed on the right, field by field, with what differs marked.
      Edit the proposal if it needs it, then approve it to put it live, or reject it.
    </p>
  </section>
</div>
