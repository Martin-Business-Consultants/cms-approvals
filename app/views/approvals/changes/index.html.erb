<% @page_title = "Approvals" %>
<% content_for :head, approvals_stylesheet_tag %>

<%= render "layouts/shared/page_header", title: @page_title,
      description: "Changes an agent made through the API, the cms CLI or MCP wait here. Open one to compare it with what’s live, edit it, and approve it." %>

<div class="grid grid--2">
  <% bulk = @state == "pending" && @changes.any? && Current.user.can?("approvals:decide") %>
  <% list_controller = bulk ? "select-all" : "" %>
  <section class="panel" aria-label="Proposed changes" data-controller="<%= list_controller %>">
    <nav class="approvals__tabs" aria-label="Show">
      <% [["pending", "Waiting"], ["decided", "Decided"]].each do |state, label| %>
        <%# herb:key state %>
        <%= link_to approvals_changes_path(state: (state unless state == "pending")),
              class: class_names("approvals__tab", "approvals__tab--current": @state == state), aria: { current: (@state == state ? "page" : nil) } do %>
          <%= label %> <span class="text-muted"><%= @counts[state] %></span>
        <% end %>
      <% end %>
    </nav>
    <% if bulk then %>
      <%# Approve or reject the ticked ones, as proposed. %>
      <%= form_with url: approvals_bulk_decisions_path, id: "approvals_bulk", class: "cluster approvals__bulk" do %>
        <label class="choice">
          <input type="checkbox" data-select-all-target="all" data-action="select-all#toggle" aria-label="Tick every change">
          <span>All</span>
        </label>
        <span class="row push-end">
          <button type="submit" name="decision" value="reject" class="btn btn--danger btn--sm"
                  data-turbo-confirm="Reject the ticked changes? Nothing in them goes live.">Reject ticked</button>
          <button type="submit" name="decision" value="approve" class="btn btn--primary btn--sm"
                  data-turbo-confirm="Approve the ticked changes as proposed? They go live.">Approve ticked</button>
        </span>
      <% end %>
    <% end %>
    <% if @changes.any? then %>
      <ul class="divided">
        <% @changes.each do |change| %>
          <%# herb:key change.id %>
          <li id="<%= dom_id(change) %>" class="approvals__item">
            <% if bulk then %>
              <label class="approvals__tick" aria-label="Tick <%= change.summary %>">
                <input type="checkbox" name="ids[]" value="<%= change.id %>" form="approvals_bulk" data-select-all-target="box" data-action="select-all#sync">
              </label>
            <% end %>
            <%= link_to approvals_change_path(change), class: "approvals__link" do %>
              <span class="stack stack--2xs grow">
                <span class="truncate text-medium text-ink"><%= change.summary %></span>
                <span class="text-small text-muted">
                  <%= change.proposed_by %> · <%= time_ago_tag change.created_at %>
                  <% if change.pending? then %> · <%= pluralize(change.changed_fields.size, "field") %><% end %>
                </span>
                <% if change.pending? && change.stale? then %>
                  <span class="text-small text-danger">The live <%= change.kind %> changed since this was proposed</span>
                <% end %>
              </span>
              <%= status_tag change.state.capitalize %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="empty-state">
        <%= @state == "pending" ? "Nothing waiting. When an agent changes a page, an entry or a global through the API, the change lands here instead of going live." : "Nothing decided yet." %>
      </p>
    <% end %>
  </section>

  <section class="panel approvals__intro" aria-label="Comparison">
    <%= icon_tag "check-circle", class: "text-faint" %>
    <p class="text-medium text-ink">Open a change to compare it</p>
    <p class="measure--sm text-muted">
      What’s live now shows here on the left, what’s proposed on the right, field by field, with what differs marked.
      Edit the proposal if it needs it, then approve it to put it live, or reject it.
    </p>
  </section>
</div>
