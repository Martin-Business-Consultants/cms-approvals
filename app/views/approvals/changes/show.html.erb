<% @page_title = "Approval" %>
<%# One change in the two columns: what's live now on the left, the proposal
    on the right, a row per field that differs (an SEO panel or a set of
    fields, key by key; within blocks or JSON-LD, only the parts that
    changed), words taken out and put in marked, the proposal editable while
    it waits. Back, at the top right, returns to the list. %>
<% edits = @edits || {} %>
<% decidable = @change.pending? && Current.user.can?("approvals:decide") && Current.user.can?(@change.capability_to_decide) %>
<% deleting = @change.action == "destroy" %>
<% creating = @change.action == "create" %>
<% fields = @change.fields %>
<% shown = (creating || deleting) ? fields : fields.select(&:changed?) %>
<% unchanged = fields.size - shown.size %>

<% content_for :page_actions do %>
  <%= link_to approvals_changes_path(state: (@change.pending? ? nil : "decided")), class: "btn btn--sm" do %>
    <span aria-hidden="true">←</span> Back to the list
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @change.summary,
      description: "From #{@change.proposed_by}, #{time_ago_in_words(@change.created_at)} ago · #{@change.state.capitalize}" +
        (@change.decided_by ? " by #{@change.decided_by.name.presence || @change.decided_by.email}" : "") %>

<% if @change.pending? && @change.stale? then %>
  <div class="notice notice--danger" role="alert">
    The live <%= @change.kind %> changed after this was proposed. The left column is what’s there now; approving replaces it with the right.
  </div>
<% end %>

<div class="panel">
  <div class="approvals__grid">
    <div class="approvals__head">Live now</div>
    <div class="approvals__head">
      <span>
        <%= @change.pending? ? "Proposed" : "As #{@change.state}" %>
        <% if decidable then %>
          <span class="approvals__editable" title="Change the proposal below before you approve it">Editable</span>
        <% end %>
      </span>
      <% if decidable then %>
        <span class="row">
          <%= button_to "Reject", approvals_change_rejection_path(@change), class: "btn btn--danger btn--sm", form_class: "contents" %>
          <button type="submit" form="approval_form" class="btn btn--primary btn--sm"><%= deleting ? "Approve and delete" : "Approve and put live" %></button>
        </span>
      <% end %>
    </div>

    <%= form_with url: approvals_change_approval_path(@change), id: "approval_form", class: "contents" do %>
      <% shown.each do |field| %>
        <%# herb:key field.name %>
        <% if field.by_key? && !deleting then %>
          <% field.keys.select { |row| row[4] || creating }.each do |key, key_label, live, proposed, changed, nested| %>
            <%# herb:key key %>
            <% if nested && !creating then %>
              <%# Only the parts of it that changed; the whole of it, to edit, folded away. %>
              <%= render "approvals/changes/change_rows", rows: field.changes(within: key_label, live: live, proposed: proposed) %>
              <% if decidable then %>
                <% typed = edits.dig(field.name, key) || (proposed.nil? ? "" : JSON.pretty_generate(proposed)) %>
                <%= render "approvals/changes/json_editor", label: key_label, name: "fields[#{field.name}][#{key}]", typed: typed, open: edits.dig(field.name, key).present? %>
              <% end %>
            <% else %>
              <% live_classes = class_names("approvals__cell approvals__cell--live", "approvals__cell--removed": changed && !creating && live.present?) %>
              <% proposed_classes = class_names("approvals__cell", "approvals__cell--added": changed && proposed.present?) %>
              <div class="approvals__label"><%= key_label %></div>
              <div class="<%= live_classes %>">
                <% if creating then %>
                  <span class="text-faint">New <%= @change.kind %></span>
                <% else %>
                  <%= render "approvals/changes/diff_value", value: live, other: proposed, side: :live %>
                <% end %>
              </div>
              <div class="<%= proposed_classes %>">
                <% if decidable then %>
                  <% typed = edits.dig(field.name, key) || (nested ? (proposed.nil? ? "" : JSON.pretty_generate(proposed)) : proposed.to_s) %>
                  <% height = nested ? (typed.lines.size + 1).clamp(4, 30) : (typed.length.fdiv(60).ceil + 1).clamp(2, 8) %>
                  <% input_classes = class_names("full-width", "text-mono text-small": nested) %>
                  <%= text_area_tag "fields[#{field.name}][#{key}]", typed, rows: height, class: input_classes, aria: { label: key_label } %>
                <% else %>
                  <%= render "approvals/changes/diff_value", value: proposed, other: live, side: :proposed %>
                <% end %>
              </div>
            <% end %>
          <% end %>
        <% elsif field.json? && !creating && !deleting then %>
          <%# A list or object compared whole (the blocks): only what changed in it. %>
          <%= render "approvals/changes/change_rows", rows: field.changes %>
          <% if decidable then %>
            <% typed = edits.fetch(field.name) { field.proposed.nil? ? "" : JSON.pretty_generate(field.proposed) } %>
            <%= render "approvals/changes/json_editor", label: field.label, name: "fields[#{field.name}]", typed: typed, open: edits.key?(field.name) %>
          <% end %>
        <% else %>
          <% live_classes = class_names("approvals__cell approvals__cell--live", "approvals__cell--removed": field.changed? && !creating && field.live.present?) %>
          <% proposed_classes = class_names("approvals__cell", "approvals__cell--added": field.changed? && !deleting && field.proposed.present?) %>
          <div class="approvals__label"><%= field.label %></div>
          <div class="<%= live_classes %>">
            <% if creating then %>
              <span class="text-faint">New <%= @change.kind %></span>
            <% elsif field.json? || deleting then %>
              <%= render "approvals/changes/value", value: field.live, json: field.json? %>
            <% else %>
              <%= render "approvals/changes/diff_value", value: field.live, other: field.proposed, side: :live %>
            <% end %>
          </div>
          <div class="<%= proposed_classes %>">
            <% if deleting then %>
              <span class="text-danger">Deleted: it goes to the trash</span>
            <% elsif decidable then %>
              <% typed = edits.fetch(field.name) { field.json? ? (field.proposed.nil? ? "" : JSON.pretty_generate(field.proposed)) : field.proposed.to_s } %>
              <% height = (typed.to_s.lines.size + 1).clamp(4, 24) %>
              <% if field.kind == "text" then %>
                <%= text_field_tag "fields[#{field.name}]", typed, class: "full-width", aria: { label: field.label } %>
              <% else %>
                <%= text_area_tag "fields[#{field.name}]", typed, rows: height,
                      class: class_names("full-width", "text-mono text-small": field.json?), aria: { label: field.label } %>
              <% end %>
            <% elsif field.json? then %>
              <%= render "approvals/changes/value", value: field.proposed, json: true %>
            <% else %>
              <%= render "approvals/changes/diff_value", value: field.proposed, other: field.live, side: :proposed %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <% if shown.none? then %>
      <p class="approvals__note">The proposal is the same as what’s live.</p>
    <% elsif unchanged.positive? then %>
      <p class="approvals__note"><%= pluralize(unchanged, "other field") %> unchanged.</p>
    <% end %>
    <% if @change.other_attributes.any? && !deleting then %>
      <p class="approvals__note">Also sets <%= @change.other_attributes.keys.map(&:humanize).to_sentence.downcase %>, as proposed.</p>
    <% end %>
    <% if @change.pending? && !decidable then %>
      <p class="approvals__note">Your role can’t decide this: it takes <code>approvals:decide</code> and <code><%= @change.capability_to_decide %></code>.</p>
    <% end %>
  </div>
</div>
