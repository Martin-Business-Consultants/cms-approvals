<% @page_title = "Approval" %>
<%# One change in the two columns: what's live now on the left, the proposal
    on the right, a row per field that differs (an SEO panel or a set of
    fields, key by key), the proposal editable while it waits. Back, at the
    top right, returns to the list. %>
<% edits = @edits || {} %>
<% decidable = @change.pending? && Current.user.can?("approvals:decide") && Current.user.can?(@change.capability_to_decide) %>
<% deleting = @change.action == "destroy" %>
<% creating = @change.action == "create" %>
<% fields = @change.fields %>
<% shown = (creating || deleting) ? fields : fields.select(&:changed?) %>
<% unchanged = fields.size - shown.size %>

<% content_for :page_actions do %>
  <%= link_to approvals_changes_path(state: (@change.pending? ? nil : "decided")), class: ui(:button, :small) do %>
    <span aria-hidden="true">←</span> Back to the list
  <% end %>
<% end %>
<%= render "layouts/shared/page_header", title: @change.summary,
      description: "From #{@change.proposed_by}, #{time_ago_in_words(@change.created_at)} ago · #{@change.state.capitalize}" +
        (@change.decided_by ? " by #{@change.decided_by.name.presence || @change.decided_by.email}" : "") %>

<% if @change.pending? && @change.stale? %>
  <div class="<%= ui(:notice, :red, "mb-4") %>" role="alert">
    The live <%= @change.kind %> changed after this was proposed. The left column is what’s there now; approving replaces it with the right.
  </div>
<% end %>

<div class="<%= ui(:panel, "approvals approvals--compare") %>">
  <div class="approvals__grid">
    <div class="approvals__head approvals__head--live">Live now</div>
    <div class="approvals__head approvals__head--proposed">
      <span><%= @change.pending? ? "Proposed" : "As #{@change.state}" %></span>
      <% if decidable then %>
        <span class="flex items-center gap-2">
          <%= button_to "Reject", approvals_change_rejection_path(@change), class: ui(:button, :small, "text-red-700"), form_class: "contents" %>
          <button type="submit" form="approval_form" class="<%= ui(:button, :primary, :small) %>"><%= deleting ? "Approve and delete" : "Approve and put live" %></button>
        </span>
      <% end %>
    </div>

    <%= form_with url: approvals_change_approval_path(@change), id: "approval_form", class: "contents" do %>
      <% shown.each do |field| %>
        <%# herb:key field.name %>
        <% if field.by_key? && !deleting %>
          <% field.keys.select { |row| row.last || creating }.each do |key, key_label, live, proposed, changed| %>
            <%# herb:key key %>
            <% live_classes = class_names("approvals__cell approvals__cell--live", "approvals__cell--removed": changed && !creating) %>
            <% proposed_classes = class_names("approvals__cell", "approvals__cell--added": changed) %>
            <div class="approvals__label"><%= key_label %></div>
            <div class="<%= live_classes %>">
              <% if creating %>
                <span class="text-sm text-gray-400">New <%= @change.kind %></span>
              <% else %>
                <%= render "approvals/changes/value", value: live %>
              <% end %>
            </div>
            <div class="<%= proposed_classes %>">
              <% if decidable then %>
                <% typed = edits.dig(field.name, key) || proposed.to_s %>
                <% height = (typed.length.fdiv(60).ceil + 1).clamp(2, 8) %>
                <%= text_area_tag "fields[#{field.name}][#{key}]", typed, rows: height, class: "w-full", aria: { label: key_label } %>
              <% else %>
                <%= render "approvals/changes/value", value: proposed %>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <% live_classes = class_names("approvals__cell approvals__cell--live", "approvals__cell--removed": field.changed? && !creating) %>
          <% proposed_classes = class_names("approvals__cell", "approvals__cell--added": field.changed? && !deleting) %>
          <div class="approvals__label"><%= field.label %></div>
          <div class="<%= live_classes %>">
            <% if creating %>
              <span class="text-sm text-gray-400">New <%= @change.kind %></span>
            <% else %>
              <%= render "approvals/changes/value", value: field.live, json: field.json? %>
            <% end %>
          </div>
          <div class="<%= proposed_classes %>">
            <% if deleting %>
              <span class="text-sm text-red-700">Deleted: it goes to the trash</span>
            <% elsif decidable then %>
              <% typed = edits.fetch(field.name) { field.json? ? (field.proposed.nil? ? "" : JSON.pretty_generate(field.proposed)) : field.proposed.to_s } %>
              <% height = (typed.to_s.lines.size + 1).clamp(4, 24) %>
              <% if field.kind == "text" %>
                <%= text_field_tag "fields[#{field.name}]", typed, class: "w-full", aria: { label: field.label } %>
              <% else %>
                <%= text_area_tag "fields[#{field.name}]", typed, rows: height,
                      class: class_names("w-full", "font-mono text-xs": field.json?), aria: { label: field.label } %>
              <% end %>
            <% else %>
              <%= render "approvals/changes/value", value: field.proposed, json: field.json? %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <% if shown.none? %>
      <p class="approvals__note">The proposal is the same as what’s live.</p>
    <% elsif unchanged.positive? %>
      <p class="approvals__note"><%= pluralize(unchanged, "other field") %> unchanged.</p>
    <% end %>
    <% if @change.other_attributes.any? && !deleting %>
      <p class="approvals__note">Also sets <%= @change.other_attributes.keys.map(&:humanize).to_sentence.downcase %>, as proposed.</p>
    <% end %>
    <% if @change.pending? && !decidable %>
      <p class="approvals__note">Your role can’t decide this: it takes <code>approvals:decide</code> and <code><%= @change.capability_to_decide %></code>.</p>
    <% end %>
  </div>
</div>
